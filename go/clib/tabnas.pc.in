# pkg-config for libtabnasjsonic (tabnas-clib-template: v1)
# Install alongside the built library; substitute @PREFIX@ at install.
prefix=@PREFIX@
libdir=${prefix}/lib
includedir=${prefix}/include

Name: libtabnasjsonic
Description: jsonic parser (libtabnasjsonic) — uniform tabnas C ABI (ADR-12)
Version: @VERSION@
Libs: -L${libdir} -ltabnasjsonic
Cflags: -I${includedir}
